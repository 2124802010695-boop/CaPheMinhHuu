@startuml Sequence_POS
title Luồng: Thu ngân bán hàng POS (Revised)

actor "Cashier" as cashier
participant "SmartPOS UI" as ui
participant "API Server" as server
database "Database" as db
participant "BOM Service" as bom
database "Kho" as inventory
participant "SignalR" as signalr
participant "KDS" as kds

cashier -> ui: Chọn món
ui -> server: GET /api/products
server -> db: Query
db --> server: Products
server --> ui: Products
ui --> cashier: Hiển thị

cashier -> ui: Chọn size
cashier -> ui: Thêm giỏ
ui -> ui: Tính tổng

cashier -> ui: Bấm "Đặt món"
ui -> server: POST /api/orders

server -> bom: CheckStock(BOM)
bom --> server: BOM Data
server -> db: Query Inventory
db --> server: Stock Data

alt Thiếu nguyên liệu
    server --> ui: Error: "Món hết hàng"
    ui --> cashier: Hiển thị lỗi
else Stock OK
    server -> db: Create Order\n(OrderType=TakeAway,\nStatus=Confirmed)
    server -> db: Create OrderDetails
    db --> server: Order Created
    
    server -> inventory: DeductStock()
    inventory --> server: Stock Updated
    
    server -> signalr: Broadcast NewOrder
    signalr -> kds: Realtime
    kds -> kds: Bếp làm ngay
    
    server --> ui: Success
    ui --> cashier: Hiển thị "Đã đặt món"
    
    cashier -> ui: Bấm "Thanh toán"
    ui -> server: PATCH /api/orders/{id}/payment
    server -> db: Update IsPaid=true
    server -> db: Update ShiftRevenue
    db --> server: Payment Success
    server --> ui: Success
    
    ui -> ui: Print Bill
    ui --> cashier: Hóa đơn
end

@enduml
