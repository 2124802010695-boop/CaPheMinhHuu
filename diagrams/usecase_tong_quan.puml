@startuml UseCase_TongQuan_GonGang
title Sơ đồ Use Case Tổng Quan - SmartPOS

actor "Admin" as admin
actor "Cashier" as cashier
actor "Bếp" as kitchen
actor "Khách hàng" as customer

rectangle "HỆ THỐNG SMARTPOS" {
  
  usecase "Quản lý\nHệ thống" as manage
  usecase "Bán hàng\nPOS" as pos
  usecase "Bếp\nKDS" as kds
  usecase "Đặt món\nOnline" as order
}

admin --> manage
cashier --> pos
kitchen --> kds
customer --> order

note right of manage
  - Sản phẩm, Danh mục
  - Nguyên liệu, BOM
  - Bàn, QR Code
  - Nhân viên
  - Dashboard, Báo cáo
end note

note right of pos
  - Đăng nhập
  - Mở/Đóng ca
  - Bán hàng
  - Quản lý bàn
end note

note right of kds
  - Xem đơn realtime
  - Cập nhật trạng thái
  - Nhập kho
  - Kiểm kho
end note

note right of order
  - Xem menu
  - Đặt món QR Code
  - Đặt món Web
  - Theo dõi đơn
end note

@enduml
